{
	"name": "@p4/api",
	"version": "1.0.0",
	"description": "P4 Game Backend API",
	"main": "dist/app.js",
	"scripts": {
		"start": "node ./dist/app.js",
		"build": "prisma generate && tsc -p tsconfig.build.json",
		"dev": "prisma generate && tsx watch src/app.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:studio": "prisma studio"
	},
	"type": "module",
	"author": "",
	"license": "ISC",
	"files": [
		"dist"
	],
	"packageManager": "pnpm@11.20.0",
	"dependencies": {
		"@fastify/cookie": "catalog:",
		"@fastify/cors": "catalog:",
		"@fastify/oauth2": "catalog:",
		"@fastify/swagger": "catalog:",
		"@fastify/swagger-ui": "catalog:",
		"@prisma/adapter-mariadb": "catalog:",
		"@prisma/client": "catalog:",
		"bcrypt": "catalog:",
		"cookie": "catalog:",
		"dotenv": "catalog:",
		"fastify": "catalog:",
		"fastify-type-provider-zod": "catalog:",
		"jsonwebtoken": "catalog:",
		"pino": "catalog:",
		"socket.io": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/bcrypt": "catalog:",
		"@types/jsonwebtoken": "catalog:",
		"@types/node": "catalog:",
		"@typescript-eslint/eslint-plugin": "catalog:",
		"@typescript-eslint/parser": "catalog:",
		"eslint": "catalog:",
		"openapi-types": "catalog:",
		"prisma": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
